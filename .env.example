# =============================================================================
#  Copia este archivo a `.env` en la raíz del proyecto.
#
#  Nada aquí es obligatorio: sin DEEPSEEK_API_KEY la app funciona igual, solo
#  en modo recuperación (sin generar respuestas). El .env es la única fuente
#  de verdad — el código no esconde valores por defecto para esta sección.
#
#  [!!] El `.env` NUNCA se sube al repositorio: está en .gitignore. Contiene tu
#       clave de API, y una vez publicada hay que reescribir el historial de git.
# =============================================================================

# --- Capa de generación (OPCIONAL) -------------------------------------------
# Si defines DEEPSEEK_API_KEY, entonces AI_MODEL y AI_MODEL_BASE_URL pasan a ser
# OBLIGATORIOS: la app falla con un mensaje claro si falta alguno.
#
# QUÉ SALE DEL EQUIPO: la recuperación, los embeddings y las descripciones son
# locales. Con la clave puesta, a la nube viajan solo los fragmentos que la
# búsqueda devolvió. Sin la clave, no sale nada.
#
# OJO: `deepseek-flash` acepta TAMBIÉN imágenes, aunque el nombre no lo diga.
# El nombre legacy `deepseek-v4-flash-vision-exp` está retirado y redirige a él.
# Ver la sección "La salida a la nube" del README antes de usar esa vía: con
# imágenes sale el documento ENTERO, no el fragmento.
# DEEPSEEK_API_KEY=
# AI_MODEL=deepseek-flash
# AI_MODEL_BASE_URL=https://api.deepseek.com

# --- Descripción de imágenes (OPCIONAL, local) --------------------------------
# Modelo de Ollama que describe cada imagen al indexarla, para que deje de ser
# solo ENCONTRABLE y pase a ser RESPONDIBLE. Debe aceptar imágenes.
# El razonamiento se apaga automáticamente (`think=False`): medido, 101 s -> 5 s
# por imagen. Si no defines estas variables, la ingesta funciona igual.
#
# MEDIDO (2026-10-09): el prompt por defecto pide "una o dos frases" y devuelve
# el 12% del texto de una página. Pidiendo la transcripción completa devuelve el
# 98% con 99% de cobertura de palabras, y TARDA MENOS. Es la diferencia entre
# encontrar una foto de un informe en papel y poder leerlo.
#
# VISION_PROMPT admite dos valores:
#   descripcion  (por defecto) una o dos frases factuales
#   extraccion   transcribe todo el texto visible
#
# ⚠️ Con `extraccion` el texto lo produce un modelo: REVÍSALO antes de indexarlo.
# Medido: `gemma4:e2b` transcribió mal un número de teléfono. La pestaña "Textos
# para revisar" existe justo para esto.
# VISION_MODEL=gemma4:e2b
# VISION_BASE_URL=http://localhost:11434
# VISION_PROMPT=descripcion

# --- Transcripción de audio (OPCIONAL, local) ---------------------------------
# Convierte un audio en texto para que sea RESPONDIBLE, no solo encontrable.
# Requiere `faster-whisper` y descarga el modelo la primera vez.
# Ollama NO transcribe: su API solo acepta `audio` en /api/embed.
# El idioma va FIJO y no se autodetecta: en audios cortos la detección falla.
# WHISPER_MODEL=small          # tiny ~75 MB · base ~140 MB · small ~460 MB · medium ~1.5 GB
# WHISPER_DEVICE=cpu           # `cuda` exige las DLLs de CUDA de ctranslate2
# WHISPER_LANGUAGE=es

# --- Video (OPCIONAL, local) ---------------------------------------------------
# No hay nada que instalar ni que configurar: PyAV llega con faster-whisper y trae
# FFmpeg embebido. El modelo no decodifica video — mira fotogramas del encoder de
# visión a 1 fps —, así que aquí solo se ajusta el muestreo y la fragmentación.
# Un video más largo que VIDEO_CHUNK_SECONDS se parte: el procesador admite como
# mucho VIDEO_MAX_FRAMES fotogramas por vector, y cada fragmento es un vector.
# VIDEO_FPS=1
# VIDEO_CHUNK_SECONDS=32
# VIDEO_MAX_FRAMES=32

# --- Ajustes opcionales del motor --------------------------------------------
# MODEL_ID=google/embeddinggemma-2
# EMBED_DIM=768          # matryoshka: 768 (nativo), 512, 256 o 128.
#                        # Cambiarlo exige borrar `chroma_db/`: la dimensión
#                        # queda fijada al crear la colección.
# TOP_K=8                          # cuántos fragmentos recupera cada consulta

# --- Precio de los tokens (OPCIONAL) --------------------------------------------
# Solo para que el panel de métricas ponga precio al consumo. Son las tarifas de
# DeepSeek verificadas el 2026-10-07, en dólares por 1M tokens y en hora valle — la
# hora peak cuesta el doble. Si usas otro proveedor, corrígelas.
# PRICE_INPUT=0.15
# PRICE_OUTPUT=0.60
